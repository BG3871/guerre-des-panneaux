# Copiez ce fichier en .env.local et remplissez avec les valeurs de votre projet Supabase
# (Project Settings > API). Sans ces valeurs, l'appli tourne en mode local (données dans le navigateur).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Optionnel : autre fond de carte (par défaut, les tuiles OpenStreetMap).
# VITE_TILE_URL=https://{s}.tile.openstreetmap.fr/osmfr/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=© contributeurs OpenStreetMap

# Uniquement pour scripts/import-osm.mjs (ne jamais mettre dans le front ni committer) :
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
